# MediaMTX + curl
# 카메라 동기화 훅에서 Spring API 호출용

FROM bluenviron/mediamtx:latest

# mediamtx 이미지는 scratch 기반이므로 멀티스테이지 빌드 사용
FROM alpine:latest

# curl 설치 (동기화 훅에서 Spring API 호출용)
RUN apk add --no-cache curl

# mediamtx 바이너리 복사
COPY --from=bluenviron/mediamtx:latest /mediamtx /mediamtx

# 설정 파일 디렉토리
WORKDIR /

ENTRYPOINT ["/mediamtx"]
