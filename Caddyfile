localhost {
    tls internal

    # 백엔드
    handle /api/* {
        reverse_proxy host.docker.internal:8080
    }

    # 클립 스토리지 (MinIO presigned URL 프록시)
    handle /clip/* {
        reverse_proxy aegis-minio:9000 {
            header_up Host localhost:9000
        }
    }

    # MediaMTX
    handle /stream/* {
        uri strip_prefix /stream
        reverse_proxy aegis-mediamtx:8889
    }

    # 프론트엔드
    handle {
        reverse_proxy host.docker.internal:3000
    }
}
