localhost {
    tls internal

    # 백엔드
    handle /api/* {
        reverse_proxy host.docker.internal:8080
    }

    # MediaMTX
    handle /stream/* {
        uri strip_prefix /stream
        reverse_proxy aegis-mediamtx:8889
    }

    # 프론트엔드
    handle {
        reverse_proxy host.docker.internal:3000
    }
}
